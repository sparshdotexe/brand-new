### Variables
set $mod Mod4
set $terminal ghostty
set $menu rofi -show drun
set $browser zen-browser
set $editor nvim
set $fileManager yazi

### Startup
exec_always waybar
exec_always swww-daemon && swww img ~/pictures/walls/pixel-art.jpg
exec_always ~/.config/hypr/scripts/night-mode
exec_always sh -c 'echo 50 | sudo tee /sys/class/power_supply/BAT0/charge_control_end_threshold'

### Input
input * {
    xkb_layout us
    xkb_variant dvorak
    xkb_options caps:escape

    repeat_rate 35
    repeat_delay 200

    natural_scroll enabled
}

### Mouse
input "epic-mouse-v1" {
    pointer_accel -0.5
}

### Gaps & Borders
gaps inner 3
gaps outer 3
default_border pixel 2

### Colors
client.focused #1e1e1e #1e1e1e #ffffff #1e1e1e
client.unfocused #000000 #000000 #888888 #000000

### Layout
workspace_layout default

### Keybindings

# Terminal / apps
bindsym $mod+Return exec $terminal
bindsym $mod+Shift+B exec $browser
bindsym $mod+Shift+N exec $terminal -e $editor
bindsym $mod+Shift+F exec $terminal -e $fileManager
bindsym $mod+Shift+Y exec $browser https://www.youtube.com/
bindsym $mod+Shift+P exec $browser https://www.coursera.org/my-learning?myLearningTab=IN_PROGRESS
bindsym $mod+Shift+A exec $browser https://chatgpt.com/?temporary-chat=true
bindsym $mod+Shift+apostrophe exec $browser https://chatgpt.com/
bindsym $mod+Shift+R exec obsidian
bindsym $mod+Shift+L exec localsend

# Kill / exit
bindsym $mod+C kill
bindsym $mod+M exec "swaymsg exit"

# Launcher
bindsym $mod+space exec $menu

# Fullscreen
bindsym $mod+F fullscreen toggle

# Floating
bindsym $mod+P floating toggle

# Split toggle
bindsym $mod+J layout toggle split

# Focus movement
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# Move windows
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Resize
mode "resize" {
    bindsym Left resize shrink width 20 px
    bindsym Right resize grow width 20 px
    bindsym Up resize shrink height 20 px
    bindsym Down resize grow height 20 px
    bindsym Return mode "default"
}
bindsym $mod+Alt+R mode "resize"

# Workspaces
set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# Screenshot
bindsym Print exec grim ~/pictures/screenshots/output.png
bindsym $mod+Print exec grim -g "$(slurp)" ~/pictures/screenshots/region.png

# Notifications
bindsym $mod+comma exec swaync-client -C

# Media
bindsym Alt+R exec playerctl play-pause

# Suspend
bindsym $mod+Shift+backslash exec systemctl suspend

# Volume / Brightness
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec light -A 5
bindsym XF86MonBrightnessDown exec light -U 5

# Custom scripts
bindsym $mod+Alt+B exec ~/.config/hypr/scripts/toggle-battery-limit
bindsym $mod+Alt+N exec pkill hyprsunset || ~/.config/hypr/scripts/night-mode
bindsym $mod+W exec pkill waybar || waybar
bindsym $mod+Ctrl+B exec ~/.config/hypr/scripts/battery-state
bindsym $mod+Ctrl+T exec notify-send "$(date +'%H:%M')" "$(date +'%A, %d %B')"
